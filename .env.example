# Copy to .env or export in your shell. Secrets live in environment variables
# only: never in code, committed config, or logs.

# Companies House REST API key. Free, requires an account on the
# Companies House developer hub.
COMPANIES_HOUSE_API_KEY=

# Model provider for synthesis. Exactly one is needed, or none: without a
# model the tool produces a deterministic findings memo and says so.
# Select the model with FIRSTPASS_MODEL, for example:
#   FIRSTPASS_MODEL=anthropic:claude-opus-5
#   FIRSTPASS_MODEL=openai:gpt-5.6-sol
#   FIRSTPASS_MODEL=ollama:qwen2.5:7b
# FIRSTPASS_MODEL=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Ollama needs no key. Override the local endpoint only if not default:
# OLLAMA_BASE_URL=http://localhost:11434
# Context window for local models (synthesis input needs room; default 16384):
# FIRSTPASS_OLLAMA_NUM_CTX=16384
# Reasoning-family local models (qwen3 non-coder variants and similar) corrupt
# schema-constrained output when their thinking mode is active. Set this to
# false for those models; leave unset for models without a thinking mode:
# FIRSTPASS_OLLAMA_THINK=false

# Sanctions and PEP screening via OpenSanctions. Commercial use requires
# your own licence and key; see README data sources. For self-hosted yente,
# set the base URL and leave the key unset.
# OPENSANCTIONS_API_KEY=
# OPENSANCTIONS_BASE_URL=https://api.opensanctions.org

# Adverse media fallback search (used when the configured model provider
# has no native web search, for example with local models).
# TAVILY_API_KEY=
