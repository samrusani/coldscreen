# Copy to .env or export in your shell. Secrets live in environment variables
# only: never in code, committed config, or logs.

# Companies House REST API key. Free, requires an account on the
# Companies House developer hub.
COMPANIES_HOUSE_API_KEY=

# The variables below are only read from the synthesis milestone onwards.
# Set the one that matches your model provider; leave the rest unset.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# Ollama needs no key; it is addressed via local HTTP.

# Sanctions and adverse media (later milestones):
# OPENSANCTIONS_API_KEY=
