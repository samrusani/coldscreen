# Optional configuration for coldscreen. Copy to coldscreen.toml in the
# directory you run the tool from. Precedence: CLI flag, then environment
# variable (COLDSCREEN_<NAME> upper case, for example COLDSCREEN_OUTPUT_DIR),
# then this file, then built-in defaults.
#
# Secrets never live here. The Companies House key comes from the
# COMPANIES_HOUSE_API_KEY environment variable only.

# Where case directories are written.
output_dir = "cases"

# HTTP cache location. Empty string means the platform user cache directory.
# Set to ".coldscreen_cache" to keep the cache next to your project.
cache_dir = ""

# Cache time to live in days.
cache_ttl_days = 7

# Client-side throttle. Companies House documents 600 requests per 5 minute
# window; stay under it.
rate_limit_requests = 500
rate_limit_window_seconds = 300

# Pagination. Page size and caps are configuration because Companies House
# does not document defaults or maxima. Truncation is always reported.
items_per_page = 100
max_pages_officers = 10
max_pages_psc = 10
max_pages_filing_history = 3
max_pages_appointments = 5

# Officers resigned within this many years are kept in the casefile.
officer_lookback_years = 5

# Wholesale officer change finding triggers when resignations in the last
# 12 months reach max(this value, half the active officer count).
wholesale_change_min = 2

# HTTP timeout in seconds.
timeout_seconds = 30

# Synthesis model as "provider:model" (split on the first colon, so Ollama
# model names keep their own colon). Empty means no synthesis: the screen
# completes deterministically and the memo says so. Overridden by
# COLDSCREEN_MODEL and by --model.
#   model = "anthropic:claude-opus-5"
#   model = "openai:gpt-5.6-sol"
#   model = "ollama:qwen2.5:7b"
model = ""

# Sanctions and PEP screening (OpenSanctions hosted API or self-hosted
# yente). The API key comes from the OPENSANCTIONS_API_KEY environment
# variable ONLY; a self-hosted endpoint from OPENSANCTIONS_BASE_URL. With
# neither set the stage is skipped with an explicit finding. Scores are
# identity-match confidence, not risk. The docs suggest 0.8 to 0.85 to cut
# false positives; the default mirrors the API default.
sanctions_dataset = "default"
sanctions_threshold = 0.7
sanctions_algorithm = "best"
sanctions_limit = 5

# Adverse media search results kept per query (key via TAVILY_API_KEY).
media_results_per_query = 5

# Claims extraction input caps. max_deck_bytes rejects an oversized deck
# file before any parsing (50 MB default); max_deck_pages caps how many
# deck pages are read; max_claims_chars caps the combined deck-plus-site
# text handed to the model (any cut is recorded as an explicit finding);
# max_site_response_bytes caps how much of a single site response is read.
max_deck_bytes = 50000000
max_deck_pages = 40
max_claims_chars = 60000
max_site_response_bytes = 2000000

# Local model calls can be slow on big models; this timeout applies to the
# Ollama HTTP client only.
ollama_timeout_seconds = 600

# Ollama context window (options.num_ctx). The daemon default (4096 on most
# models) silently truncates long prompts, and a model reasoning over a
# truncated casefile is worse than no model at all. The default covers the
# synthesis prompt plus a compact casefile with headroom; raise it for
# unusually large casefiles, lower it on tight-memory machines. Also
# settable via COLDSCREEN_OLLAMA_NUM_CTX.
ollama_num_ctx = 16384

# Ollama thinking mode (the top-level "think" request field). Reasoning-family
# local models (for example qwen3 non-coder variants) need
# ollama_think = false for reliable schema-constrained synthesis: with
# thinking active they return corrupted or empty content. Leave this unset
# for models that do not support thinking, which can reject the field
# outright. Unset means the field is never sent. Also settable via
# COLDSCREEN_OLLAMA_THINK (true/false, or 1/0).
#   ollama_think = false
